\begin{tikzpicture}[xscale=1.5, yscale=1.2, >=stealth]

    % Obsidian Dark Theme Palette Definitions
    \definecolor{obsidianbg}{RGB}{30, 30, 30}       % #1E1E1E Background
    \definecolor{obsidiantext}{RGB}{220, 221, 222}   % #DCDDDE Off-White Text/Axes
    \definecolor{obsidiangrid}{RGB}{55, 55, 55}       % #373737 Low-contrast Grid
    \definecolor{obsidianaccent}{RGB}{220, 221, 222}  % #7F6DF2 Obsidian Purple Accent

    % Canvas Background Box
    \fill[obsidianbg] (-1.3, -1.1) rectangle (4.6, 6.2);

    % Background Grid
    \draw[very thin, obsidiangrid] (0,0) grid[xstep=1, ystep=1] (4,5);

    % Axes
    \draw[->, thick, obsidiantext] (0,0) -- (4.3,0);
    \draw[->, thick, obsidiantext] (0,0) -- (0,5.4);

    % Axis Ticks & Numbers
    \foreach \x in {0, 1, 2, 3, 4} {
        \draw[obsidiantext] (\x,0) -- (\x,-0.1) node[below, font=\tiny\sffamily, text=obsidiantext] {\x};
    }
    \foreach \y in {0, 1, 2, 3, 4, 5} {
        \draw[obsidiantext] (0,\y) -- (-0.08,\y) node[left, font=\tiny\sffamily, text=obsidiantext] {\y};
    }

    % Axis Labels
    \node[font=\large\itshape, text=obsidiantext] at (2, -0.7) {\emph{Krabby Patties ordered}};
    \node[rotate=90, font=\large\itshape, text=obsidiantext] at (-0.6, 2.5) {\emph{Pizza Slices ordered}};

    % Budget Constraint / Utility Line
    \draw[thick, obsidianaccent] (0, 5) -- (4, 0);

    % Indifference Curves (I1, I2, I3) - Clamped to y <= 5 domain
    \draw[thick, obsidiantext, domain=0.6:4.0, samples=100] plot (\x, {3.0/\x});
    \node[above right, font=\small, text=obsidiantext] at (1.0, 3.0) {$I_1$};

    \draw[thick, obsidiantext, domain=1.0:4.0, samples=100] plot (\x, {5.0/\x});
    \node[above right, font=\small, text=obsidiantext] at (1.4, 3.5) {$I_2$};

    \draw[thick, obsidiantext, domain=1.5:4.0, samples=100] plot (\x, {7.5/\x});
    \node[above right, font=\small, text=obsidiantext] at (1.9, 3.9) {$I_3$};

    % Point A: (0, 5)
    \node[circle, fill=obsidianaccent, inner sep=1.25pt] at (0, 5) {};
    \node[below right=2pt, text=obsidiantext] at (0, 4.75) {A};

    % Point B: (2, 2.5)
    \node[circle, fill=obsidianaccent, inner sep=1.25pt] at (2, 2.5) {};
    \node[below right=2pt, text=obsidiantext] at (1.75, 2.5) {B};

    % Point C: (4, 0)
    \node[circle, fill=obsidianaccent, inner sep=1.25pt] at (4, 0) {};
    \node[left=2pt, text=obsidiantext] at (3.75, 0.25) {C};

    % Title
    \node[above, font=\small, text=obsidiantext] at (2, 5.7) {Figure 3: Patrick's Orders};

\end{tikzpicture}